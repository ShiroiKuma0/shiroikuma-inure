<?xml version="1.0" encoding="utf-8"?>
<app.simple.inure.decorations.theme.ThemeLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="12dp">

    <!-- Giant colour circle with the previously-picked colour dots floating over its top -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="320dp">

        <app.simple.inure.decorations.colorpicker.ColorPickerView
            android:id="@+id/color_picker_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <app.simple.inure.decorations.overscroll.CustomHorizontalRecyclerView
            android:id="@+id/colors_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@android:color/transparent"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp" />

    </FrameLayout>

    <include
        layout="@layout/adapter_shiroikuma_slider_row"
        android:id="@+id/row_r" />

    <include
        layout="@layout/adapter_shiroikuma_slider_row"
        android:id="@+id/row_g" />

    <include
        layout="@layout/adapter_shiroikuma_slider_row"
        android:id="@+id/row_b" />

    <include
        layout="@layout/adapter_shiroikuma_slider_row"
        android:id="@+id/row_a" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <app.simple.inure.decorations.corners.DynamicCornerEditText
            android:id="@+id/color_hex_code"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:digits="#0123456789ABCDEFabcdef"
            android:hint="#AARRGGBB"
            android:inputType="textNoSuggestions"
            android:maxLength="9"
            android:singleLine="true" />

        <app.simple.inure.decorations.corners.DynamicCornerAccentColor
            android:id="@+id/color_strip"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="end"
        android:orientation="horizontal">

        <app.simple.inure.decorations.ripple.DynamicRippleTextView
            android:id="@+id/cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/dialog_padding"
            android:text="@string/cancel"
            app:appFontStyle="bold"
            app:textColorStyle="accent" />

        <app.simple.inure.decorations.ripple.DynamicRippleTextView
            android:id="@+id/set"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:padding="@dimen/dialog_padding"
            android:text="@string/ok"
            app:appFontStyle="bold"
            app:textColorStyle="accent" />

    </LinearLayout>

</app.simple.inure.decorations.theme.ThemeLinearLayout>
